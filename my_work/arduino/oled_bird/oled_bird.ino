/*
  White bird on a black OLED.
  The body climbs from the lower right to the upper left.
  Upper wing and lower wing both change shape.
  Arduino UNO R4 WiFi, SH1106 128x64 at 0x3C on A4/A5.
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>

