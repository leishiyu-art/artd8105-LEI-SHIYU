const int H = 64;
const int BW = 40;
const int BH = 34;
const int STEP = 2;
const int X0 = W;
const int X1 = -BW;
const int Y0 = H - BH;
const int Y1 = 0;

Adafruit_SH1106G display(W, H, &Wire, -1);

