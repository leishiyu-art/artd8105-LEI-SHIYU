const uint8_t *const POSES[] = {BIRD_0, BIRD_1, BIRD_2, BIRD_1};

int birdX = X0;
int pose = 0;
int steps = 0;
bool oledOk = false;

int birdY() {
  return Y0 + (birdX - X0) * (Y1 - Y0) / (X1 - X0);
}

void drawBird() {
  display.clearDisplay();
  display.drawBitmap(birdX, birdY(), POSES[pose], BW, BH, SH110X_WHITE);
  display.display();
}

void setup() {
  Serial.begin(115200);
  delay(300);
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);

  Wire.begin();
  Wire.setClock(100000);

  oledOk = display.begin(0x3C, false);
  digitalWrite(LED_BUILTIN, oledOk ? LOW : HIGH);
  Serial.println(oledOk ? "OLED_OK" : "OLED_MISSING");
  if (oledOk) drawBird();
}

void loop() {
  if (!oledOk) {
    digitalWrite(LED_BUILTIN, (millis() / 180) % 2 ? HIGH : LOW);
    return;
  }

  birdX -= STEP;
  steps++;
  if (steps >= 3) {
    steps = 0;
    pose = (pose + 1) % 4;
  }
  if (birdX < X1) {
    birdX = X0;
    pose = 0;
    steps = 0;
    delay(400);
  }
  drawBird();
  delay(30);
}
